---
import { Code2, Gamepad2, Sparkles, BookOpen, FlaskConical, Wrench } from 'lucide-astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/ui/PageIntro.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import { getAllProjects, getAllResearch, getAllMembers } from '../lib/content';

const projectCount = (await getAllProjects()).length;
const researchCount = (await getAllResearch()).length;
const memberCount = getAllMembers().length;

const directions = [
  {
    icon: Code2,
    title: '软件开发',
    text: '以工程严谨构建软件与工具：设计系统、文档引擎、类型库与内容管线，追求长期可维护。',
  },
  {
    icon: Gamepad2,
    title: '游戏与交互',
    text: '叙事驱动与机制实验并重，用可运行的原型回答「为什么这样设计」。',
  },
  {
    icon: Sparkles,
    title: 'AI 应用',
    text: '把模型能力放进真实工作流，用结构化约束换取稳定、可信的行为。',
  },
  {
    icon: BookOpen,
    title: '学术探索',
    text: '技术报告、预印本与实验记录公开沉淀，让研究与作品互为印证。',
  },
  {
    icon: FlaskConical,
    title: '实验创作',
    text: '声音、图像、程序化生成与交互装置，探索媒介的边界，允许失败。',
  },
];

const principles = [
  {
    no: '01',
    title: '内容与表现分离',
    text: '作者只写内容，结构由 schema 保证，表现由组件与主题承担。新增一篇文章不需要触碰模板。',
  },
  {
    no: '02',
    title: '克制地选择技术',
    text: '不追逐技术堆砌。依赖只有在必要性明确时才会被引入，能长期维护是唯一标准。',
  },
  {
    no: '03',
    title: '研究驱动创作',
    text: '每一个方向都保留实验与记录的空间：方法、结论与局限被整理为可阅读的报告。',
  },
  {
    no: '04',
    title: '以作品验证想法',
    text: '理念不以宣言为证，而以可运行、可体验的作品为证。',
  },
];
---

<BaseLayout title="关于" description="关于匣方艺创（Xia Fundery）：工作室定位、创作方向与技术原则。">
  <div class="shell py-16 md:py-24">
    <PageIntro
      eyebrow="About"
      title="关于匣方艺创"
      lead="一个以技术为基底、以创作为导向的独立工作室。我们同时是工程师、设计师与研究者。"
    />

    <section class="mt-14 grid gap-10 md:grid-cols-12" data-reveal>
      <div class="md:col-span-7">
        <p class="font-display text-2xl font-semibold leading-relaxed text-ink-950 md:text-3xl">
          匣方，取意「匣中藏方物」——把零散的技艺收进一个容器，需要时再取出来，赋予其形状。
        </p>
      </div>
      <div class="space-y-5 text-base leading-relaxed text-ink-600 md:col-span-5">
        <p>
          匣方艺创（Xia Fundery）成立于 2025 年，是一个小规模的独立工作室。我们不追求规模，
          而是追求每一次交付的完整度：无论是一个游戏、一套工具，还是一篇技术报告。
        </p>
        <p>
          工程与创作在这里不是对立的：技术为作品提供底盘，作品为技术提供方向。研究则把两者之间的
          实践沉淀为可以被阅读、被复现、被延续的东西。
        </p>
      </div>
    </section>

    <section class="mt-20 border-t border-ink-200/70 pt-16" data-reveal>
      <SectionHeading eyebrow="Directions" title="创作方向" />
      <div class="grid gap-px overflow-hidden rounded-2xl border border-ink-200/70 bg-ink-200/70 sm:grid-cols-2 lg:grid-cols-3">
        {directions.map((dir, i) => (
          <div class="group bg-paper-50 p-7 transition-colors hover:bg-paper-100">
            <dir.icon size={22} stroke-width={1.6} class="text-accent-600" />
            <h3 class="mt-4 font-display text-lg font-semibold text-ink-950">
              <span class="mr-2 font-mono text-sm font-normal text-mist-500">{String(i + 1).padStart(2, '0')}</span>
              {dir.title}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-600">{dir.text}</p>
          </div>
        ))}
        <div class="flex flex-col items-start justify-center gap-4 bg-ink-950 p-7 text-paper-50">
          <p class="font-mono text-[0.68rem] uppercase tracking-[0.2em] text-paper-100/60">Studio Index</p>
          <dl class="flex gap-8">
            <div>
              <dd class="font-display text-3xl font-semibold">{projectCount}</dd>
              <dt class="font-mono text-[0.64rem] uppercase tracking-[0.16em] text-paper-100/50">项目</dt>
            </div>
            <div>
              <dd class="font-display text-3xl font-semibold">{researchCount}</dd>
              <dt class="font-mono text-[0.64rem] uppercase tracking-[0.16em] text-paper-100/50">研究</dt>
            </div>
            <div>
              <dd class="font-display text-3xl font-semibold">{memberCount}</dd>
              <dt class="font-mono text-[0.64rem] uppercase tracking-[0.16em] text-paper-100/50">成员</dt>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <section class="mt-20 border-t border-ink-200/70 pt-16" data-reveal>
      <SectionHeading eyebrow="Principles" title="技术原则" />
      <ol class="mt-10 space-y-10">
        {principles.map((p) => (
          <li class="grid gap-4 md:grid-cols-12 md:items-start">
            <span class="font-mono text-sm text-accent-600 md:col-span-2">{p.no}</span>
            <div class="md:col-span-10">
              <h3 class="font-display text-xl font-semibold text-ink-950">{p.title}</h3>
              <p class="mt-2 max-w-2xl text-[0.95rem] leading-relaxed text-ink-600">{p.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="mt-20 border-t border-ink-200/70 pt-16" data-reveal>
      <SectionHeading eyebrow="Open & Collaborative" title="协作与开源" />
      <div class="grid gap-10 md:grid-cols-2">
        <div class="space-y-5 text-base leading-relaxed text-ink-600">
          <p>
            我们默认以开源的方式工作：能公开的内容尽可能公开，包括工具、文档与研究记录。
            开源对我们而言不是营销，而是对「可复用、可学习」的承诺。
          </p>
          <p>
            外部协作以项目为单位进行：明确的职责边界、可验证的交付物、以及留在文档里的决策过程。
          </p>
        </div>
        <div class="rounded-2xl border border-ink-200/80 bg-paper-100/40 p-7">
          <h3 class="flex items-center gap-2 font-display text-lg font-semibold text-ink-950">
            <Wrench size={18} stroke-width={1.6} class="text-accent-600" />
            当前开放的工程
          </h3>
          <ul class="mt-4 space-y-3 text-sm text-ink-700">
            <li class="flex items-baseline gap-2">
              <span class="h-1.5 w-1.5 translate-y-[-1px] rounded-full bg-accent-500" />
              Fathom · 类型工具库（开源）
            </li>
            <li class="flex items-baseline gap-2">
              <span class="h-1.5 w-1.5 translate-y-[-1px] rounded-full bg-accent-500" />
              灯塔 · 文档引擎（公开化中）
            </li>
            <li class="flex items-baseline gap-2">
              <span class="h-1.5 w-1.5 translate-y-[-1px] rounded-full bg-accent-500" />
              匣形 · 设计系统（组件文档公开）
            </li>
          </ul>
          <p class="mt-5 font-mono text-[0.66rem] uppercase tracking-[0.14em] text-mist-500">
            链接地址待工作室正式公布后补充
          </p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
