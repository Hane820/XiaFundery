---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import Manifesto from '../components/home/Manifesto.astro';
import FeaturedProjects from '../components/home/FeaturedProjects.astro';
import ResearchPreview from '../components/home/ResearchPreview.astro';
import TeamPreview from '../components/home/TeamPreview.astro';
import {
  getAllProjects,
  getAllResearch,
  getAllMembers,
  getFeaturedProjects,
} from '../lib/content';

const projects = await getAllProjects();
const featuredProjects = (await getFeaturedProjects()).slice(0, 4);
const allResearch = await getAllResearch();
const research = allResearch.slice(0, 3);
const allMembers = getAllMembers();
const members = allMembers.slice(0, 3);
---

<BaseLayout dataPage="home">
  <Hero
    projectCount={projects.length}
    researchCount={allResearch.length}
    memberCount={allMembers.length}
  />
  <Manifesto />
  <FeaturedProjects projects={featuredProjects} />
  <ResearchPreview items={research} />
  <TeamPreview members={members} />
</BaseLayout>
