---
import { ArrowRight } from 'lucide-astro';
import type { CollectionEntry } from 'astro:content';
import { RESEARCH_TYPES } from '../../lib/site';

interface Props {
  research: CollectionEntry<'research'>;
  authors: { name: string; slug: string }[];
}

const { research, authors } = Astro.props;
const d = research.data;
const typeInfo = RESEARCH_TYPES[d.type];
const year = d.year ?? d.date?.getFullYear();
---

<article
  class="group grid gap-3 border-t border-ink-200/70 py-6 md:grid-cols-12 md:items-baseline md:py-7"
  data-filter-item
  data-type={d.type}
  data-status={d.status}
  data-reveal
>
  <div class="flex flex-col gap-1.5 md:col-span-3">
    <span class="font-mono text-[0.68rem] uppercase tracking-[0.18em] text-ink-500">
      {typeInfo?.label}
    </span>
    <span class="font-mono text-sm text-ink-600">{year ?? '—'}</span>
  </div>

  <div class="md:col-span-9">
    <a href={`/research/${d.slug}`} class="block">
      <h3 class="font-display text-xl font-semibold leading-snug text-ink-950 transition-colors duration-300 group-hover:text-accent-600">
        {d.title}
      </h3>
    </a>
    <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-ink-600">{d.summary}</p>
    <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-ink-500">
      {authors.length > 0 && (
        <span class="flex flex-wrap items-center gap-x-3">
          {authors.map((a, i) => (
            <span>
              {i > 0 && <span class="mr-3 text-ink-300">·</span>}
              {a.name}
            </span>
          ))}
        </span>
      )}
      {d.keywords.slice(0, 3).map((k) => (
        <span class="tag">#{k}</span>
      ))}
      <span class="inline-flex items-center gap-1 font-display text-[0.8rem] font-semibold text-ink-700 opacity-0 transition-opacity duration-300 group-hover:opacity-100">
        阅读
        <ArrowRight size={13} stroke-width={2} />
      </span>
    </div>
  </div>
</article>
