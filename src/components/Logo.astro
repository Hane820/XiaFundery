---
interface Props {
  light?: boolean;
  compact?: boolean;
}

const { light = false, compact = false } = Astro.props;
const titleColor = light ? 'text-paper-50' : 'text-ink-900';
const subColor = light ? 'text-paper-100/70' : 'text-ink-500';
---

<span class="flex items-center gap-2.5">
  <svg viewBox="0 0 48 48" class="h-8 w-8 shrink-0" aria-hidden="true">
    <rect x="4" y="4" width="40" height="40" rx="10" fill="none" stroke="currentColor" stroke-width="3" />
    <rect x="13" y="13" width="22" height="22" rx="5" fill="none" stroke="currentColor" stroke-width="2" opacity="0.55" />
    <rect x="20" y="20" width="8" height="8" rx="2" fill="currentColor" />
  </svg>
  {
    !compact && (
      <span class="flex flex-col leading-none">
        <span class={`font-display text-base font-semibold tracking-tight ${titleColor}`}>匣方艺创</span>
        <span class={`font-mono text-[0.6rem] uppercase tracking-[0.22em] mt-1 ${subColor}`}>Xia Fundery</span>
      </span>
    )
  }
</span>
