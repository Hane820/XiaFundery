---
import { ArrowRight } from 'lucide-astro';
import type { CollectionEntry } from 'astro:content';
import { PROJECT_TYPES } from '../../lib/site';
import CoverImage from '../ui/CoverImage.astro';
import StatusBadge from '../ui/StatusBadge.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  eager?: boolean;
  className?: string;
}

const { project, eager = false, className = '' } = Astro.props;
const d = project.data;
const typeInfo = PROJECT_TYPES.find((t) => t.value === d.type);
---

<article
  class={['group flex flex-col', className].join(' ')}
  data-filter-item
  data-type={d.type}
  data-status={d.status}
  data-reveal
>
  <a
    href={`/projects/${d.slug}`}
    class="block overflow-hidden rounded-2xl border border-ink-200/80 bg-paper-100"
  >
    <div class="aspect-[10/7] w-full">
      <CoverImage
        src={d.image}
        alt={`${d.name} 项目封面`}
        eager={eager}
        className="transition-transform duration-[700ms] ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.045]"
      />
    </div>
  </a>

  <div class="mt-4 flex items-center justify-between gap-3">
    <span class="eyebrow">{typeInfo?.label}</span>
    <StatusBadge status={d.status} />
  </div>

  <a href={`/projects/${d.slug}`} class="mt-1.5 block">
    <h3 class="font-display text-xl font-semibold leading-snug text-ink-950 transition-[color,transform] duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:translate-x-1 group-hover:text-accent-600">
      {d.name}
    </h3>
  </a>
  <p class="mt-1.5 line-clamp-2 text-sm leading-relaxed text-ink-600">{d.summary}</p>

  <div class="mt-3 flex flex-wrap gap-1.5">
    {d.tech.slice(0, 4).map((t) => <span class="tag">{t}</span>)}
  </div>

  <span class="mt-4 inline-flex items-center gap-1.5 font-display text-sm font-semibold text-ink-700 opacity-60 transition-[opacity,color,margin] duration-300 group-hover:ml-1 group-hover:opacity-100 group-hover:text-accent-600">
    查看详情
    <ArrowRight size={14} stroke-width={2} />
  </span>
</article>
