---
import { ArrowUp } from 'lucide-astro';
---

<button
  type="button"
  data-back-to-top
  aria-label="返回顶部"
  class="fixed bottom-6 right-6 z-40 inline-flex h-11 w-11 items-center justify-center rounded-full border border-ink-300 bg-paper-50/90 text-ink-800 shadow-sm opacity-0 pointer-events-none transition-[opacity,color,border-color] duration-300 hover:border-ink-900 hover:text-ink-950 focus-visible:opacity-100"
>
  <ArrowUp size={18} stroke-width={1.8} />
</button>

<style>
  [data-back-to-top].is-visible {
    opacity: 1;
    pointer-events: auto;
  }
</style>
