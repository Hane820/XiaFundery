---
import { ArrowRight } from 'lucide-astro';

interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  href?: string;
  linkLabel?: string;
  tone?: 'light' | 'dark';
}

const { eyebrow, title, intro, href, linkLabel = '查看全部', tone = 'light' } = Astro.props;
const dark = tone === 'dark';
---

<div class="mb-10 flex flex-col gap-6 md:flex-row md:items-end md:justify-between" data-reveal>
  <div class="max-w-2xl">
    {eyebrow && <p class={['eyebrow mb-3', dark && 'text-paper-100/50'].filter(Boolean).join(' ')}>{eyebrow}</p>}
    <h2 class={['text-3xl font-semibold md:text-4xl', dark ? 'text-paper-50' : 'text-ink-950'].join(' ')}>
      {title}
    </h2>
    {intro && (
      <p class={['mt-3 text-[0.95rem] leading-relaxed', dark ? 'text-paper-100/65' : 'text-ink-600'].join(' ')}>
        {intro}
      </p>
    )}
  </div>
  {
    href && (
      <a href={href} class="link-more shrink-0">
        <span class={dark ? 'text-paper-50' : ''}>{linkLabel}</span>
        <ArrowRight class="icon" size={16} stroke-width={2} />
      </a>
    )
  }
</div>
