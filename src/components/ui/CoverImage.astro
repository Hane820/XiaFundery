---
interface Props {
  src?: string;
  alt: string;
  eager?: boolean;
  className?: string;
}

const { src, alt, eager = false, className = '' } = Astro.props;
---

{
  src ? (
    <img
      src={src}
      alt={alt}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      class={`h-full w-full object-cover ${className}`}
    />
  ) : (
    <div
      role="img"
      aria-label={alt}
      class={[
        'relative h-full w-full overflow-hidden bg-ink-100',
        'bg-[linear-gradient(to_right,var(--color-ink-200)_1px,transparent_1px),linear-gradient(to_bottom,var(--color-ink-200)_1px,transparent_1px)]',
        'bg-[size:1.5rem_1.5rem]',
        className,
      ].join(' ')}
    >
      <span class="absolute inset-0 grid place-items-center font-mono text-[0.7rem] uppercase tracking-[0.2em] text-ink-400">
        无封面
      </span>
    </div>
  )
}
